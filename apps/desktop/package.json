{
  "name": "@hr-agent-system/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "node ../../scripts/start-desktop.js",
    "start": "electron .",
    "start:prod": "node ../../scripts/start-desktop.js --prod",
    "check": "node ../../scripts/check-desktop.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.hragentsystem.desktop",
    "productName": "智能人事客户端",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "../web/dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  }
}
