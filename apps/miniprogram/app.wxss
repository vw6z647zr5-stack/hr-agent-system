page {
  background: #f7faf9;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.card {
  border: 1rpx solid rgba(15, 118, 110, 0.1);
  border-radius: 16rpx;
  background: #ffffff;
  padding: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.subtitle {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.label {
  margin-bottom: 10rpx;
  color: #475569;
  font-size: 24rpx;
}

.input,
.textarea,
.picker {
  min-height: 84rpx;
  border: 1rpx solid #d8e5e1;
  border-radius: 12rpx;
  background: #ffffff;
  padding: 0 22rpx;
  box-sizing: border-box;
  color: #0f172a;
}

.textarea {
  min-height: 144rpx;
  padding-top: 18rpx;
}

.button-primary {
  border-radius: 12rpx;
  background: #0f766e;
  color: #ffffff;
}

.button-plain {
  border-radius: 12rpx;
  background: #eef7f5;
  color: #0f766e;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.metric {
  border-radius: 14rpx;
  background: #f1f8f6;
  padding: 22rpx;
}

.metric-value {
  color: #0f766e;
  font-size: 40rpx;
  font-weight: 700;
}

.metric-label {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.tag {
  display: inline-flex;
  border-radius: 999rpx;
  background: #ecfdf5;
  padding: 6rpx 16rpx;
  color: #047857;
  font-size: 22rpx;
}

.muted {
  color: #64748b;
}

.danger {
  color: #dc2626;
}

.empty {
  padding: 60rpx 20rpx;
  color: #94a3b8;
  text-align: center;
}
