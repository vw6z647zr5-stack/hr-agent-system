<view class="page">
  <view class="card section">
    <view class="title">开放职位</view>
    <view class="subtitle">选择岗位后上传简历，候选人信息会同步到招聘工作台。</view>
  </view>

  <view wx:for="{{jobs}}" wx:key="id" class="card job-card">
    <view class="row">
      <view class="job-title">{{item.title}}</view>
      <view class="tag">{{item.statusText}}</view>
    </view>
    <view class="subtitle">{{item.location}} · {{item.employmentTypeText}}</view>
    <view class="job-desc">{{item.description}}</view>
    <button class="button-plain" data-index="{{index}}" bindtap="selectJob">投递这个岗位</button>
  </view>

  <view wx:if="{{!jobs.length && !loading}}" class="empty">暂无开放职位</view>

  <view class="card section">
    <view class="title">投递信息</view>
    <view class="subtitle">当前岗位：{{selectedJobTitle}}</view>
    <view class="form-item">
      <view class="label">姓名</view>
      <input class="input" value="{{fullName}}" bindinput="onFullNameInput" placeholder="请输入姓名" />
    </view>
    <view class="form-item">
      <view class="label">邮箱</view>
      <input class="input" value="{{email}}" bindinput="onEmailInput" placeholder="请输入邮箱" />
    </view>
    <view class="form-item">
      <view class="label">手机号</view>
      <input class="input" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入手机号" />
    </view>
    <view class="form-item">
      <view class="label">工作年限</view>
      <input class="input" type="number" value="{{yearsOfExperience}}" bindinput="onYearsInput" placeholder="例如：5" />
    </view>
    <view class="form-item">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{notes}}" bindinput="onNotesInput" placeholder="可填写期望岗位、技能或到岗时间" />
    </view>
    <button class="button-plain" bindtap="chooseResume">{{resumeName || '选择简历文件'}}</button>
    <button class="button-primary submit-button" loading="{{submitting}}" bindtap="submitApplication">提交投递</button>
  </view>

  <view wx:if="{{candidateProfile.candidate}}" class="card">
    <view class="title">我的候选人档案</view>
    <view class="info-line">姓名：{{candidateProfile.candidate.fullName}}</view>
    <view class="info-line">阶段：{{candidateProfile.candidate.stageText}}</view>
    <view class="info-line">岗位：{{candidateProfile.candidate.jobTitle}}</view>
  </view>
</view>
