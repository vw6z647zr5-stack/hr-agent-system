.tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 26rpx;
}

.tab {
  border-radius: 12rpx;
  background: #f1f5f9;
  padding: 18rpx 8rpx;
  color: #64748b;
  text-align: center;
}

.tab.active {
  background: #0f766e;
  color: #ffffff;
}

.form-item {
  margin-bottom: 22rpx;
}

.request-row {
  border-top: 1rpx solid #e2e8f0;
  padding-top: 22rpx;
  margin-top: 22rpx;
}
