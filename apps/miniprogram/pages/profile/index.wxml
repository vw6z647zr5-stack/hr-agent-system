<view class="page">
  <view class="card section">
    <view class="title">{{user.displayName || '未登录'}}</view>
    <view class="subtitle">{{roleLabel}} · {{user.email || '-'}}</view>
  </view>

  <view class="card section">
    <view class="title small-title">接口配置</view>
    <view class="form-item">
      <view class="label">后端接口地址</view>
      <input class="input" value="{{apiBase}}" bindinput="onApiBaseInput" placeholder="例如：http://127.0.0.1:3000/api" />
    </view>
    <button class="button-primary" bindtap="saveApiBase">保存接口地址</button>
  </view>

  <view class="card section">
    <view class="title small-title">账号状态</view>
    <view class="info-line">用户名：{{user.username || '-'}}</view>
    <view class="info-line">角色：{{roleLabel}}</view>
    <view class="info-line">员工编号：{{user.employeeId || '-'}}</view>
  </view>

  <button class="button-plain" bindtap="logout">退出登录</button>
</view>
