{
  "name": "hr-agent-system",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/desktop",
    "apps/mobile"
  ],
  "scripts": {
    "start": "node scripts/start-all.js",
    "dev:api": "npm --workspace @hr-agent-system/api run dev",
    "dev:web": "npm --workspace @hr-agent-system/web run dev",
    "dev:miniprogram": "node scripts/start-miniprogram.js",
    "dev:desktop": "node scripts/start-desktop.js",
    "start:desktop": "node scripts/start-desktop.js --prod",
    "build:api": "npm --workspace @hr-agent-system/api run build",
    "build:web": "npm --workspace @hr-agent-system/web run build",
    "build:miniprogram": "node scripts/check-miniprogram.js",
    "build:desktop": "node scripts/check-desktop.js",
    "build:mobile": "node scripts/check-mobile.js",
    "build": "npm run build:api && npm run build:web",
    "lint": "npm --workspace @hr-agent-system/api run lint && npm --workspace @hr-agent-system/web run lint",
    "check:copy": "node scripts/check-chinese-copy.js",
    "check:miniprogram": "node scripts/check-miniprogram.js",
    "check:desktop": "node scripts/check-desktop.js",
    "check:mobile": "node scripts/check-mobile.js",
    "verify:robustness": "node scripts/verify-robustness.js",
    "verify:surface": "node scripts/verify-surface.js",
    "verify:workflow": "node scripts/verify-workflow.js",
    "verify:commercial": "node scripts/check-commercial-readiness.js",
    "migrate:status": "node scripts/run-migrations.js status",
    "migrate:dry-run": "node scripts/run-migrations.js dry-run",
    "migrate:up": "node scripts/run-migrations.js up",
    "migrate:baseline": "node scripts/run-migrations.js baseline",
    "migrate:bootstrap": "node scripts/run-migrations.js bootstrap",
    "release:check": "node scripts/run-release-check.js",
    "verify": "npm run check:copy && npm run check:miniprogram && npm run check:desktop && npm run check:mobile && npm run lint && npm run build",
    "verify:full": "npm run verify && node scripts/verify-full-flow.js && npm run verify:surface",
    "backup:local": "node scripts/backup-local-data.js",
    "restore:local": "node scripts/restore-local-data.js",
    "recalc-scores": "node scripts/recalculate-all-scores.js"
  },
  "devDependencies": {
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.32"
  }
}
